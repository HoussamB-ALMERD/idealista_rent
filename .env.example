# Copy to .env.local for `vercel dev` / `next dev`, and to .env for local
# `npm run db:generate` / `npm run check:local` runs.

# --- Shared between the Vercel app and the GitHub Actions cron job ---

# Neon Postgres connection string (auto-populated by the Vercel <-> Neon
# Marketplace integration; for local dev run `vercel env pull .env.local`,
# or grab it from the Neon dashboard directly).
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# 32-byte hex key used to encrypt Telegram bot tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Vercel app only ---

# Shared passcode friends must enter on the signup form. Server-only — never
# exposed to the client bundle (do not prefix with NEXT_PUBLIC_).
APP_PASSCODE=""

# Your STABLE production domain (e.g. https://idealista-alerts.vercel.app).
# Used to build each friend's Telegram webhook URL. Do NOT use Vercel's
# per-deployment VERCEL_URL here — it changes and would break registered
# webhooks.
PUBLIC_BASE_URL=""

# --- GitHub Actions (scripts/run-check.ts) only ---

# Your Apify account token. Shared across every friend's scrape — you are
# the one paying for all of it, see README's cost note.
APIFY_TOKEN=""
